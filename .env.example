# Copy this file to .env for local development with `vercel dev`.
# In production, set these as Environment Variables in the Vercel dashboard instead
# (Project -> Settings -> Environment Variables). Never commit real keys.

# --- Stripe ---
# Secret key (starts with sk_test_... or sk_live_...)
# Found in the Stripe Dashboard under Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret (starts with whsec_...)
# Created when you add an endpoint in Stripe Dashboard -> Developers -> Webhooks
# pointing at https://yourdomain.com/api/webhook, listening for checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Supabase (your own project, not a shared/agency one) ---
# Found in your Supabase project -> Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# The "service_role" key (NOT the anon/public key) -- keeps full DB access server-side only
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Admin dashboard (/admin.html) ---
# The password you'll type in to log in to /admin.html
ADMIN_PASSWORD=choose-a-strong-password
# Random secret used to sign admin login sessions -- any long random string
ADMIN_SESSION_SECRET=generate-a-long-random-string
